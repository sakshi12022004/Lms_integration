# Master database (superadmin registry)
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_NAME=master_db
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=postgres

# Tenant database defaults
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_POOL_MAX=10
TENANT_DB_POOL_IDLE_TIMEOUT=30000
TENANT_DB_CONNECT_TIMEOUT=5000
TENANT_POOL_CACHE_SIZE=50

# Auth
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection
USE_POSTGRES=true
