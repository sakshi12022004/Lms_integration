# Master database (superadmin registry)
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_NAME=master_db
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=postgres

# Tenant database defaults
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_POOL_MAX=10
TENANT_DB_POOL_IDLE_TIMEOUT=30000
TENANT_DB_CONNECT_TIMEOUT=5000
TENANT_POOL_CACHE_SIZE=50

# Auth
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection
USE_POSTGRES=true

# ---------------------------------------------------------------------------
# AI provider - Hugging Face (backend only; never put this in frontend code)
# Loaded by server/server.js (dotenv). Read by the AI Assessment Agent
# (ai-modules/ai-assessment-agent/backend/src/llm/generationConfig.js) for test
# generation, performance reports and assignment evaluation, and by
# server/services/notificationText.js for short notification wording.
# HF_TOKEN must be a real Hugging Face token ("hf_...") for AI to switch on;
# with the placeholder below AI stays off and the LMS uses its standard text.
# ---------------------------------------------------------------------------
AIA_LLM_PROVIDER=huggingface
# "org/model" or "org/model:inference-provider" - confirm the model you want to use
AIA_LLM_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct:deepinfra
HF_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
